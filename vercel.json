{
  "rewrites": [
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/make", "destination": "/index.html" },
    { "source": "/community", "destination": "/index.html" },
    { "source": "/discover", "destination": "/index.html" },
    { "source": "/remix", "destination": "/index.html" },
    { "source": "/upload", "destination": "/index.html" },
    { "source": "/auth/sketchfab", "destination": "/index.html" },
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/build", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
